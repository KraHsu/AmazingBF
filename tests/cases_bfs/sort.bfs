// Bubble sort: read n then n integers, print sorted (space-separated).
let n: u8 = 0;
let arr: [u8; 10];
let i: u8 = 0;
let j: u8 = 0;
let bound: u8 = 0;
let t: u8 = 0;
let next: u8 = 0;

scan(n);
i = 0;
while i < n {
    scan(arr[i]);
    i = i + 1;
}

i = 0;
while i < n {
    j = 0;
    bound = n - i - 1;
    while j < bound {
        next = j + 1;
        if arr[j] > arr[next] {
            t = arr[j];
            arr[j] = arr[next];
            arr[next] = t;
        }
        j = j + 1;
    }
    i = i + 1;
}

i = 0;
while i < n {
    print(arr[i]);
    i = i + 1;
}
putchar(10);
