// @gui
// gui_danmaku.bfs - neon dodge demo on the 256x256 BFS GUI.
//
// Survive six waves of falling, drifting, homing, and sweeping neon shots.
// The old shooting loop was replaced with a dodge-first ruleset: movement is
// deliberate, and w / space spends a cooldown-limited short dash with brief
// invulnerability.
//
// Controls:
//   a / d           move left / right
//   w / space       dash in the last horizontal direction
//   q / Escape      quit
//
// The renderer injects a reserved 0-byte every ~33 ms. This script treats
// that byte as the world tick and real key bytes as input frames.
//
// Run with: bfsc examples/gui_danmaku.bfs -o /tmp/gui_danmaku.bf
//           bf-gui /tmp/gui_danmaku.bf

fn draw_bullet(x: u8, y: u8, c: u8) {
    setpixel(x + 2, y, c);
    setpixel(x + 1, y + 1, c);
    setpixel(x + 2, y + 1, 255);
    setpixel(x + 3, y + 1, c);
    setpixel(x, y + 2, c);
    setpixel(x + 1, y + 2, 255);
    setpixel(x + 2, y + 2, c);
    setpixel(x + 3, y + 2, 255);
    setpixel(x + 4, y + 2, c);
    setpixel(x + 1, y + 3, c);
    setpixel(x + 2, y + 3, 255);
    setpixel(x + 3, y + 3, c);
    setpixel(x + 2, y + 4, c);
}

fn erase_bullet(x: u8, y: u8) {
    draw_bullet(x, y, 0);
}

fn draw_player(x: u8, c: u8) {
    // Caller keeps x in the player lane range so x +/- 3 stays on-screen.
    setpixel(x, 236, c);
    setpixel(x - 1, 237, c);
    setpixel(x, 237, 255);
    setpixel(x + 1, 237, c);
    setpixel(x - 2, 238, c);
    setpixel(x - 1, 238, c);
    setpixel(x, 238, 255);
    setpixel(x + 1, 238, c);
    setpixel(x + 2, 238, c);
    setpixel(x - 3, 239, c);
    setpixel(x - 1, 239, c);
    setpixel(x, 239, 255);
    setpixel(x + 1, 239, c);
    setpixel(x + 3, 239, c);
    setpixel(x - 3, 240, c);
    setpixel(x - 2, 240, c);
    setpixel(x + 2, 240, c);
    setpixel(x + 3, 240, c);
    setpixel(x - 1, 241, c);
    setpixel(x + 1, 241, c);
}

fn erase_player(x: u8) {
    draw_player(x, 0);
}

fn draw_heart(x: u8, c: u8) {
    setpixel(x + 1, 4, c);
    setpixel(x + 2, 4, c);
    setpixel(x + 4, 4, c);
    setpixel(x + 5, 4, c);
    setpixel(x, 5, c);
    setpixel(x + 1, 5, 255);
    setpixel(x + 2, 5, c);
    setpixel(x + 3, 5, c);
    setpixel(x + 4, 5, 255);
    setpixel(x + 5, 5, c);
    setpixel(x + 6, 5, c);
    setpixel(x, 6, c);
    setpixel(x + 1, 6, c);
    setpixel(x + 2, 6, c);
    setpixel(x + 3, 6, 255);
    setpixel(x + 4, 6, c);
    setpixel(x + 5, 6, c);
    setpixel(x + 6, 6, c);
    setpixel(x + 1, 7, c);
    setpixel(x + 2, 7, c);
    setpixel(x + 3, 7, c);
    setpixel(x + 4, 7, c);
    setpixel(x + 5, 7, c);
    setpixel(x + 2, 8, c);
    setpixel(x + 3, 8, c);
    setpixel(x + 4, 8, c);
    setpixel(x + 3, 9, c);
}

fn draw_progress_segment(p: u8, c: u8) {
    let x: u8 = 18 + p * 34;
    let i: u8 = 0;
    while i < 28 {
        setpixel(x + i, 8, c);
        setpixel(x + i, 9, c);
        i = i + 1;
    }
}

fn draw_cooldown(cd: u8) {
    let i: u8 = 0;
    let ready: u8 = 0;
    while i < 24 {
        setpixel(4 + i, 248, 0);
        setpixel(4 + i, 249, 0);
        i = i + 1;
    }
    if cd == 0 {
        ready = 24;
    } else {
        ready = (45 - cd) / 2;
    }
    i = 0;
    while i < ready {
        setpixel(4 + i, 248, 28);
        setpixel(4 + i, 249, 31);
        i = i + 1;
    }
}

fn draw_burst(x: u8, c: u8) {
    // Same contract as draw_player: callers must keep x far enough from edges.
    setpixel(x, 232, c);
    setpixel(x - 4, 236, c);
    setpixel(x + 4, 236, c);
    setpixel(x - 6, 238, c);
    setpixel(x + 6, 238, c);
    setpixel(x - 4, 242, c);
    setpixel(x + 4, 242, c);
    setpixel(x, 246, c);
}

fn bullet_hits(bx: u8, by: u8, player_x: u8) -> u8 {
    let h: u8 = 0;
    if bx + 5 > player_x - 4 {
        if bx < player_x + 5 {
            if by + 5 > 235 {
                if by < 242 {
                    h = 1;
                }
            }
        }
    }
    return h;
}

// ---- State ----
let started: u8 = 0;
let running: u8 = 1;
let won: u8 = 0;
let seed: u8 = 0;
let key: u8 = 0;

let px: u8 = 124;
let last_dir: u8 = 1;
let player_color: u8 = 31;
let hearts: u8 = 3;
let heart_x: u8 = 0;

let phase: u8 = 0;
let phase_timer: u8 = 0;
let spawn_timer: u8 = 0;
let spawn_gate: u8 = 8;
let sweep_timer: u8 = 0;
let speed: u8 = 2;

let dash_cd: u8 = 0;
let invuln: u8 = 0;
let hurt_flash: u8 = 0;

let b0_active: u8 = 0;
let b0_x: u8 = 0;
let b0_y: u8 = 0;
let b0_kind: u8 = 0;
let b0_color: u8 = 0;
let b1_active: u8 = 0;
let b1_x: u8 = 0;
let b1_y: u8 = 0;
let b1_kind: u8 = 0;
let b1_color: u8 = 0;
let b2_active: u8 = 0;
let b2_x: u8 = 0;
let b2_y: u8 = 0;
let b2_kind: u8 = 0;
let b2_color: u8 = 0;
let b3_active: u8 = 0;
let b3_x: u8 = 0;
let b3_y: u8 = 0;
let b3_kind: u8 = 0;
let b3_color: u8 = 0;
let b4_active: u8 = 0;
let b4_x: u8 = 0;
let b4_y: u8 = 0;
let b4_kind: u8 = 0;
let b4_color: u8 = 0;

let i: u8 = 0;
let tmp: u8 = 0;
let hit: u8 = 0;
let end_color: u8 = 0;
let ex: u8 = 0;
let ey: u8 = 0;

// ---- Title / background ----
// Sparse neon starfield and a small centre sigil. The centre sigil is erased
// after the first real key, but the starfield stays as static atmosphere.
setpixel(18, 32, 3);
setpixel(40, 98, 28);
setpixel(71, 55, 31);
setpixel(93, 151, 3);
setpixel(116, 24, 28);
setpixel(148, 83, 31);
setpixel(174, 137, 3);
setpixel(203, 43, 28);
setpixel(231, 118, 31);
setpixel(33, 183, 3);
setpixel(83, 210, 28);
setpixel(139, 197, 31);
setpixel(198, 220, 3);
setpixel(238, 174, 28);

i = 0;
while i < 24 {
    setpixel(116 + i, 118, 31);
    setpixel(116 + i, 137, 31);
    setpixel(116, 118 + i, 3);
    setpixel(139, 118 + i, 3);
    i = i + 1;
}
i = 0;
while i < 10 {
    setpixel(123 + i, 127, 252);
    setpixel(127, 123 + i, 252);
    i = i + 1;
}

while started == 0 {
    getchar(key);
    if key == 0 {
        seed = seed + 1;
    }
    if key > 0 {
        started = 1;
    }
}

i = 0;
while i < 24 {
    setpixel(116 + i, 118, 0);
    setpixel(116 + i, 137, 0);
    setpixel(116, 118 + i, 0);
    setpixel(139, 118 + i, 0);
    i = i + 1;
}
i = 0;
while i < 10 {
    setpixel(123 + i, 127, 0);
    setpixel(127, 123 + i, 0);
    i = i + 1;
}

// ---- Initial HUD ----
i = 0;
while i < 6 {
    draw_progress_segment(i, 1);
    i = i + 1;
}
draw_progress_segment(0, 31);

i = 0;
while i < 3 {
    heart_x = 224 + i * 10;
    draw_heart(heart_x, 224);
    i = i + 1;
}
draw_cooldown(dash_cd);
draw_player(px, player_color);

// ---- Main game loop ----
while running > 0 {
    getchar(key);

    if key == 0 {
        // World tick.
        seed = seed * 5 + 11;

        if dash_cd > 0 {
            dash_cd = dash_cd - 1;
        }
        if invuln > 0 {
            invuln = invuln - 1;
        }
        if hurt_flash > 0 {
            hurt_flash = hurt_flash - 1;
            if hurt_flash == 0 {
                draw_burst(px, 0);
            }
        }

        phase_timer = phase_timer + 1;
        if phase_timer >= 120 {
            phase_timer = 0;
            phase = phase + 1;
            if phase < 6 {
                draw_progress_segment(phase, 31);
            } else {
                won = 1;
                running = 0;
            }
        }

        if running > 0 {
            speed = 2;
            if phase >= 2 {
                speed = 3;
            }
            if phase >= 4 {
                speed = 4;
            }

            hit = 0;

            // Slot 0: falling / diagonal / homing shot.
            if b0_active > 0 {
                erase_bullet(b0_x, b0_y);
                if b0_kind == 0 {
                    b0_y = b0_y + speed;
                } else {
                    if b0_kind == 1 {
                        b0_y = b0_y + speed + 1;
                    } else {
                        if b0_kind == 2 {
                            if b0_x >= 3 { b0_x = b0_x - 2; }
                            b0_y = b0_y + 2;
                        } else {
                            if b0_kind == 3 {
                                if b0_x <= 247 { b0_x = b0_x + 2; }
                                b0_y = b0_y + 2;
                            } else {
                                if b0_x < px {
                                    if b0_x <= 248 { b0_x = b0_x + 1; }
                                } else {
                                    if b0_x > px {
                                        if b0_x >= 1 { b0_x = b0_x - 1; }
                                    }
                                }
                                b0_y = b0_y + 2;
                            }
                        }
                    }
                }
                if b0_y >= 248 {
                    b0_active = 0;
                } else {
                    draw_bullet(b0_x, b0_y, b0_color);
                    tmp = bullet_hits(b0_x, b0_y, px);
                    if tmp == 1 { hit = 1; }
                }
            }

            // Slot 1.
            if b1_active > 0 {
                erase_bullet(b1_x, b1_y);
                if b1_kind == 0 {
                    b1_y = b1_y + speed;
                } else {
                    if b1_kind == 1 {
                        b1_y = b1_y + speed + 1;
                    } else {
                        if b1_kind == 2 {
                            if b1_x >= 3 { b1_x = b1_x - 2; }
                            b1_y = b1_y + 2;
                        } else {
                            if b1_kind == 3 {
                                if b1_x <= 247 { b1_x = b1_x + 2; }
                                b1_y = b1_y + 2;
                            } else {
                                if b1_x < px {
                                    if b1_x <= 248 { b1_x = b1_x + 1; }
                                } else {
                                    if b1_x > px {
                                        if b1_x >= 1 { b1_x = b1_x - 1; }
                                    }
                                }
                                b1_y = b1_y + 2;
                            }
                        }
                    }
                }
                if b1_y >= 248 {
                    b1_active = 0;
                } else {
                    draw_bullet(b1_x, b1_y, b1_color);
                    tmp = bullet_hits(b1_x, b1_y, px);
                    if tmp == 1 { hit = 1; }
                }
            }

            // Slot 2.
            if b2_active > 0 {
                erase_bullet(b2_x, b2_y);
                if b2_kind == 0 {
                    b2_y = b2_y + speed;
                } else {
                    if b2_kind == 1 {
                        b2_y = b2_y + speed + 1;
                    } else {
                        if b2_kind == 2 {
                            if b2_x >= 3 { b2_x = b2_x - 2; }
                            b2_y = b2_y + 2;
                        } else {
                            if b2_kind == 3 {
                                if b2_x <= 247 { b2_x = b2_x + 2; }
                                b2_y = b2_y + 2;
                            } else {
                                if b2_x < px {
                                    if b2_x <= 248 { b2_x = b2_x + 1; }
                                } else {
                                    if b2_x > px {
                                        if b2_x >= 1 { b2_x = b2_x - 1; }
                                    }
                                }
                                b2_y = b2_y + 2;
                            }
                        }
                    }
                }
                if b2_y >= 248 {
                    b2_active = 0;
                } else {
                    draw_bullet(b2_x, b2_y, b2_color);
                    tmp = bullet_hits(b2_x, b2_y, px);
                    if tmp == 1 { hit = 1; }
                }
            }

            // Slot 3.
            if b3_active > 0 {
                erase_bullet(b3_x, b3_y);
                if b3_kind == 0 {
                    b3_y = b3_y + speed;
                } else {
                    if b3_kind == 1 {
                        b3_y = b3_y + speed + 1;
                    } else {
                        if b3_kind == 2 {
                            if b3_x >= 3 { b3_x = b3_x - 2; }
                            b3_y = b3_y + 2;
                        } else {
                            if b3_kind == 3 {
                                if b3_x <= 247 { b3_x = b3_x + 2; }
                                b3_y = b3_y + 2;
                            } else {
                                if b3_x < px {
                                    if b3_x <= 248 { b3_x = b3_x + 1; }
                                } else {
                                    if b3_x > px {
                                        if b3_x >= 1 { b3_x = b3_x - 1; }
                                    }
                                }
                                b3_y = b3_y + 2;
                            }
                        }
                    }
                }
                if b3_y >= 248 {
                    b3_active = 0;
                } else {
                    draw_bullet(b3_x, b3_y, b3_color);
                    tmp = bullet_hits(b3_x, b3_y, px);
                    if tmp == 1 { hit = 1; }
                }
            }

            // Slot 4: horizontal sweeper.
            if b4_active > 0 {
                erase_bullet(b4_x, b4_y);
                if b4_kind == 5 {
                    if b4_x <= 247 {
                        b4_x = b4_x + 4;
                    } else {
                        b4_active = 0;
                    }
                } else {
                    if b4_x >= 5 {
                        b4_x = b4_x - 4;
                    } else {
                        b4_active = 0;
                    }
                }
                if b4_active > 0 {
                    draw_bullet(b4_x, b4_y, b4_color);
                    tmp = bullet_hits(b4_x, b4_y, px);
                    if tmp == 1 { hit = 1; }
                }
            }

            if hit == 1 {
                if invuln == 0 {
                    if hearts > 0 {
                        hearts = hearts - 1;
                        heart_x = 224 + hearts * 10;
                        draw_heart(heart_x, 0);
                        invuln = 24;
                        hurt_flash = 7;
                        draw_burst(px, 224);
                    }
                }
            }

            // Spawn cadence tightens by phase.
            spawn_gate = 8;
            if phase >= 1 { spawn_gate = 7; }
            if phase >= 2 { spawn_gate = 6; }
            if phase >= 3 { spawn_gate = 5; }
            if phase >= 4 { spawn_gate = 4; }

            spawn_timer = spawn_timer + 1;
            if spawn_timer >= spawn_gate {
                spawn_timer = 0;
                tmp = seed % 5;
                if b0_active == 0 {
                    b0_active = 1;
                    b0_x = seed % 240 + 8;
                    b0_y = 16;
                    b0_kind = tmp;
                    if tmp == 0 { b0_color = 31; }
                    else { if tmp == 1 { b0_color = 252; }
                    else { if tmp == 2 { b0_color = 227; }
                    else { if tmp == 3 { b0_color = 28; }
                    else { b0_color = 3; } } } }
                    draw_bullet(b0_x, b0_y, b0_color);
                } else {
                    if b1_active == 0 {
                        b1_active = 1;
                        b1_x = seed % 240 + 8;
                        b1_y = 16;
                        b1_kind = tmp;
                        if tmp == 0 { b1_color = 31; }
                        else { if tmp == 1 { b1_color = 252; }
                        else { if tmp == 2 { b1_color = 227; }
                        else { if tmp == 3 { b1_color = 28; }
                        else { b1_color = 3; } } } }
                        draw_bullet(b1_x, b1_y, b1_color);
                    } else {
                        if b2_active == 0 {
                            b2_active = 1;
                            b2_x = seed % 240 + 8;
                            b2_y = 16;
                            b2_kind = tmp;
                            if tmp == 0 { b2_color = 31; }
                            else { if tmp == 1 { b2_color = 252; }
                            else { if tmp == 2 { b2_color = 227; }
                            else { if tmp == 3 { b2_color = 28; }
                            else { b2_color = 3; } } } }
                            draw_bullet(b2_x, b2_y, b2_color);
                        } else {
                            if b3_active == 0 {
                                b3_active = 1;
                                b3_x = seed % 240 + 8;
                                b3_y = 16;
                                b3_kind = tmp;
                                if tmp == 0 { b3_color = 31; }
                                else { if tmp == 1 { b3_color = 252; }
                                else { if tmp == 2 { b3_color = 227; }
                                else { if tmp == 3 { b3_color = 28; }
                                else { b3_color = 3; } } } }
                                draw_bullet(b3_x, b3_y, b3_color);
                            }
                        }
                    }
                }
            }

            sweep_timer = sweep_timer + 1;
            if sweep_timer >= 42 {
                sweep_timer = 0;
                if b4_active == 0 {
                    b4_active = 1;
                    b4_y = 94 + seed % 112;
                    if seed % 2 == 0 {
                        b4_kind = 5;
                        b4_x = 1;
                    } else {
                        b4_kind = 6;
                        b4_x = 250;
                    }
                    b4_color = 224;
                    draw_bullet(b4_x, b4_y, b4_color);
                }
            }

            // Re-assert HUD and player; bullets can temporarily erase shared pixels.
            draw_cooldown(dash_cd);
            if invuln > 0 {
                if invuln % 2 == 0 {
                    player_color = 255;
                } else {
                    player_color = 31;
                }
            } else {
                player_color = 31;
            }
            draw_player(px, player_color);

            if hearts == 0 { running = 0; }
        }
    } else {
        // Input frame.
        if key == 97 {
            if px >= 12 {
                erase_player(px);
                px = px - 4;
                last_dir = 0;
                draw_player(px, player_color);
            }
        }
        if key == 100 {
            if px <= 242 {
                erase_player(px);
                px = px + 4;
                last_dir = 1;
                draw_player(px, player_color);
            }
        }
        if key == 32 || key == 119 {
            if dash_cd == 0 {
                erase_player(px);
                if last_dir == 0 {
                    if px >= 26 {
                        px = px - 18;
                    } else {
                        px = 8;
                    }
                } else {
                    if px <= 228 {
                        px = px + 18;
                    } else {
                        px = 246;
                    }
                }
                dash_cd = 45;
                invuln = 8;
                draw_player(px, 255);
                draw_cooldown(dash_cd);
            }
        }
        if key == 27 || key == 113 { running = 0; }
    }
}

// ---- End screen ----
if won == 1 {
    end_color = 28;
} else {
    end_color = 224;
}
ey = 96;
while ey < 160 {
    ex = 96;
    while ex < 160 {
        setpixel(ex, ey, end_color);
        ex = ex + 1;
    }
    ey = ey + 1;
}
if won == 1 {
    i = 0;
    while i < 44 {
        setpixel(106 + i, 128, 255);
        setpixel(128, 106 + i, 255);
        i = i + 1;
    }
} else {
    i = 0;
    while i < 44 {
        setpixel(106 + i, 106 + i, 255);
        setpixel(150 - i, 106 + i, 255);
        i = i + 1;
    }
}
key = 0;
while key == 0 {
    getchar(key);
}
